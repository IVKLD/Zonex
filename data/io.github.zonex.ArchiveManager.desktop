[Desktop Entry]
Name=Zonex
Comment=Wayland-Native Archive Manager with Zero-Latency Drag-and-Drop
Exec=zonex %F
Icon=io.github.zonex.ArchiveManager
Terminal=false
Type=Application
Categories=Utility;Archiving;Compression;GTK;
MimeType=application/zip;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-7z-compressed;application/x-rar;
Actions=Compress;ExtractHere;

[Desktop Action Compress]
Name=Compress with Zonex
Exec=zonex --compress %F
Icon=package-x-generic

[Desktop Action ExtractHere]
Name=Extract Here
Exec=zonex --extract-here %F
Icon=archive-extract

